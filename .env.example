# ==============================================================================
# IRON DISTRICT FITNESS - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Client Environment Variables (Exposed to browser via Vite)
# WhatsApp number in international format without '+' or spaces (e.g. 919876543210 for India, 15550194821 for US)
VITE_WHATSAPP_NUMBER=919XXXXXXXXX
VITE_SITE_URL=https://irondistrictfitness.com

# Database (Supabase Postgres)
# Obtain from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
# Service Role key is required for server-side inserts with RLS enabled
SUPABASE_SERVICE_ROLE_KEY=eyJh...your-supabase-service-role-key...

# Email Notifications (Resend API)
# Obtain from https://resend.com/api-keys
RESEND_API_KEY=re_1234567890abcdef
# Email address where new trial requests should be sent
NOTIFY_EMAIL_TO=gymowner@irondistrictfitness.com
# Verified sender domain in Resend (default for testing is onboarding@resend.dev)
NOTIFY_EMAIL_FROM=onboarding@resend.dev
